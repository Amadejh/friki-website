# FRIKI WEBSITE — Environment Variables
# Copy this file to .env.local and fill in real values
# .env.local is gitignored — NEVER commit real keys

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get from: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Server-only: never put in client components or NEXT_PUBLIC_ vars
# Get from: Supabase project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get from: Stripe dashboard → Developers → API keys
# IMPORTANT: Claim GitHub Education fee waiver BEFORE processing real payments
# education.github.com/pack → Stripe section
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...your-publishable-key...

# Server-only
STRIPE_SECRET_KEY=sk_test_...your-secret-key...

# Get from: Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
# For local dev: run `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...your-webhook-secret...

# ─── Resend ──────────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...your-api-key...
# Must be a verified sending address at resend.com → Domains
RESEND_FROM_EMAIL=events@friki.si

# ─── App ─────────────────────────────────────────────────────────────────────
# Your production domain — used for CORS and absolute URLs in emails
NEXT_PUBLIC_BASE_URL=https://friki.si
